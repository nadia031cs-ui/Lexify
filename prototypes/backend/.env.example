PORT=3000
# Frontend origins allowed by CORS (comma separated), only needed if the website is NOT served by this server.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Session lifetime in hours
SESSION_TTL_HOURS=24
# SQLite file
DB_PATH=./data/lexify.db
# Serve the website from this server too, so signup/login work on http://localhost:3000 without CORS.
# Path is relative to the folder you run `npm start` in (this layout: repo/backend + repo/prototypes/frontend).
FRONTEND_DIR=../prototypes/frontend
